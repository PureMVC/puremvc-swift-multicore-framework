{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/puremvc-swift-multicore-framework.PureMVC\/documentation\/PureMVC\/Notifier"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Notifier","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MacroCommand, Command, Mediator"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Proxy"},{"text":" ","type":"text"},{"text":"all have a need to send ","type":"text"},{"type":"codeVoice","code":"Notifications"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"INotifier"},{"type":"text","text":" interface provides a common method called"},{"type":"text","text":" "},{"type":"codeVoice","code":"sendNotification"},{"type":"text","text":" that relieves implementation code of"},{"type":"text","text":" "},{"type":"text","text":"the necessity to actually construct "},{"type":"codeVoice","code":"Notifications"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Notifier"},{"type":"text","text":" class, which all of the above mentioned classes"},{"type":"text","text":" "},{"type":"text","text":"extend, provides an initialized reference to the "},{"type":"codeVoice","code":"Facade"},{"type":"text","text":" "},{"type":"text","text":"Multiton, which is required for the convienience method"},{"type":"text","text":" "},{"type":"text","text":"for sending "},{"type":"codeVoice","code":"Notifications"},{"type":"text","text":", but also eases implementation as these"},{"type":"text","text":" "},{"type":"text","text":"classes have frequent "},{"type":"codeVoice","code":"Facade"},{"type":"text","text":" interactions and usually require